<Page
    x:Class="LegionDeck.GUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LegionDeck.GUI.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <models:SourceToColorConverter x:Key="SourceToColorConverter" />
        <models:StatusTextConverter x:Key="StatusTextConverter" />
        <models:StatusColorConverter x:Key="StatusColorConverter" />
    </Page.Resources>

    <Grid RowDefinitions="Auto,Auto,*" XYFocusKeyboardNavigation="Enabled">
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Sync All" Click="RefreshButton_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Sort" Label="Sort">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Name (A-Z)" Click="SortByName_Click" Tag="NameAsc" />
                        <MenuFlyoutItem Text="Name (Z-A)" Click="SortByName_Click" Tag="NameDesc" />
                        <MenuFlyoutItem Text="Source" Click="SortBySource_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <CommandBar.Content>
                <AutoSuggestBox x:Name="SearchBox" 
                                QueryIcon="Find" 
                                PlaceholderText="Search library..." 
                                Width="300" 
                                Margin="12,0" 
                                VerticalAlignment="Center"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                TextChanged="SearchBox_TextChanged"/>
            </CommandBar.Content>
        </CommandBar>

        <!-- Filter Chips Bar -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="12,0,12,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Filters:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Opacity="0.6"/>
                
                <!-- Status Filters -->
                <ToggleButton Content="Installed" Tag="Filter_Installed" Click="Filter_Click" IsChecked="True" />
                <ToggleButton Content="Not Installed" Tag="Filter_Cloud" Click="Filter_Click" />
                
                <Rectangle Width="1" Height="24" Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" />
                
                <!-- Source Filters -->
                <ToggleButton Content="Steam" Tag="Source_Steam" Click="Filter_Click" />
                <ToggleButton Content="Xbox" Tag="Source_Xbox" Click="Filter_Click" />
                <ToggleButton Content="Ubisoft" Tag="Source_Ubisoft" Click="Filter_Click" />
                <ToggleButton Content="EA" Tag="Source_EA" Click="Filter_Click" />
                <ToggleButton Content="Epic" Tag="Source_Epic" Click="Filter_Click" />

                <Rectangle Width="1" Height="24" Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" />

                <!-- Ownership Filters -->
                <ToggleButton Content="Claimed" Tag="State_Claimed" Click="Filter_Click" />
                <ToggleButton Content="Unclaimed (Sub)" Tag="State_Unclaimed" Click="Filter_Click" />
            </StackPanel>
        </ScrollViewer>

        <GridView Grid.Row="2"
                  x:Name="LibraryGridView"
                  Margin="12"
                  Padding="0,0,0,24"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="LibraryGridView_ItemClick"
                  XYFocusKeyboardNavigation="Enabled"
                  IsTabStop="True"
                  UseSystemFocusVisuals="True"
                  TabFocusNavigation="Cycle"
                  PreviewKeyDown="LibraryGridView_PreviewKeyDown"
                  LostFocus="LibraryGridView_LostFocus"
                  GettingFocus="LibraryGridView_GettingFocus">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryGameViewModel">
                    <Grid Width="180" Height="380" Margin="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Hide Game" Click="HideGame_Click" Icon="HideBcc" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <StackPanel Padding="0" Spacing="0">
                            <!-- 2:3 Aspect Ratio for Steam Artwork (180x270) -->
                            <Grid Height="270" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8,8,0,0">
                                <Image Source="{x:Bind ImgCapsule, Mode=OneWay}" 
                                       Stretch="Uniform" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       ImageFailed="Image_ImageFailed" />
                            </Grid>
                            
                            <StackPanel Padding="10" Spacing="4">
                                <!-- Allow 2 lines for names -->
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="Bold" 
                                           TextWrapping="Wrap" MaxLines="2" Height="40"
                                           TextTrimming="CharacterEllipsis" FontSize="13" />
                                
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay, Converter={StaticResource StatusTextConverter}}" 
                                           Foreground="{x:Bind StatusText, Mode=OneWay, Converter={StaticResource StatusColorConverter}}" 
                                           FontWeight="ExtraBold" FontSize="11" Margin="0,0,0,4" />
                                
                                <Grid>
                                    <Border Background="{x:Bind Source, Converter={StaticResource SourceToColorConverter}}" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Source}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="NoGamesText" Grid.Row="2" Text="No games found. Adjust filters." 
                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                   Opacity="0.5" Visibility="Collapsed" Style="{ThemeResource SubtitleTextBlockStyle}" />
        
        <ProgressRing x:Name="LoadingRing" Grid.Row="2" IsActive="False" Width="60" Height="60" />
    </Grid>
</Page>